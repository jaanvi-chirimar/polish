{
  "expo": {
    "name": "polish",
    "slug": "polish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polish",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
  "CFBundleURLTypes": [
    { "CFBundleURLSchemes": ["com.googleusercontent.apps.53750585316-moibdr3spps4fk1ml71tqd9uvjcij3ge"] }
  ]
},
      "supportsTablet": true,
      "bundleIdentifier": "com.jaanvi.polish",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.jaanvi.polish",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withFirebasePodfile.js",
      "./plugins/withFirebaseAppDelegate.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}